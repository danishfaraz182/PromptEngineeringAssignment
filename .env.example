# ---------------------------------------------------------------------------
# Danish Faraz International University — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# None of these are required to run the site in DEMO mode.
# ---------------------------------------------------------------------------

# Data mode: "mock" uses local mock data/services (default, no backend needed).
# "live" points the service layer at a real Spring Boot backend (see README).
VITE_DATA_MODE=mock

# Base URL of the future Spring Boot REST API.
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket / STOMP endpoint for real-time features (live feed, counters, notifications).
VITE_WS_URL=ws://localhost:8080/ws

# Public site URL, used for canonical/OG tags at build time.
VITE_SITE_URL=https://www.dfiu.edu
